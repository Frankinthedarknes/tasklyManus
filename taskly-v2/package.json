{
  "name": "taskly-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"node --import tsx --watch server/index.ts\" \"vite --host localhost\"",
    "db:migrate": "node --import tsx server/migrate.ts",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@node-rs/argon2": "2.2.1",
    "better-auth": "1.7.7",
    "better-call": "1.4.0",
    "dotenv": "18.0.5",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
